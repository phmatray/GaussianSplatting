{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Splat Live",
  "version": "0.1.0",
  "identifier": "dev.splatlive.desktop",
  "build": {
    "beforeDevCommand": {
      "script": "trunk serve --dist ../../target/trunk-dev-dist",
      "cwd": "../crates/gs-app",
      "wait": false
    },
    "devUrl": "http://127.0.0.1:8100",
    "beforeBuildCommand": {
      "script": "trunk build --release",
      "cwd": "../crates/gs-app"
    },
    "frontendDist": "../crates/gs-app/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Splat Live",
        "width": 1280,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "worker-src": "'self' blob:",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "img-src": "'self' data: blob: http://127.0.0.1:* http://localhost:*",
        "connect-src": "'self' ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:* http://localhost:* ws://localhost:*"
      }
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
